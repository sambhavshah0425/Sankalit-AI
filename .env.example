# =====================================================================
# SANKALIT INTELLIGENCE — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to '.env' and adjust values for your local environment.
# Never commit the real '.env' file or production secrets to version control.

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Absolute or relative path to the local SQLite database file
DATABASE_PATH=data/sankalit.db

# ---------------------------------------------------------------------
# Ollama Local AI Configuration
# ---------------------------------------------------------------------
# Base URL for the local Ollama instance (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Chat completion model (CPU-friendly 1.7B parameter model)
OLLAMA_MODEL=qwen3:1.7b

# Local text embedding model (768-dimensional embeddings)
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------
# Security, Authentication & JWT Configuration
# ---------------------------------------------------------------------
# Cryptographic secret key used to sign JWT access tokens (HS256).
# IMPORTANT: Generate a secure random string of at least 32 bytes for production.
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production

# JWT signature algorithm
JWT_ALGORITHM=HS256

# JWT Access token lifespan in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cryptographic Refresh token lifespan in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------
# Brute-Force Protection & Rate Limiting
# ---------------------------------------------------------------------
# Maximum consecutive failed login attempts before temporary account lockout
MAX_LOGIN_ATTEMPTS=5

# Duration of account lockout in minutes
LOCKOUT_DURATION_MINUTES=15

# ---------------------------------------------------------------------
# Registration Policy
# ---------------------------------------------------------------------
# If set to true, public users can self-register with EMPLOYEE role.
# If set to false, only administrators can register new users (bootstrap first-user is always permitted).
ALLOW_OPEN_REGISTRATION=false
